fun progress_callback (duration, fraction)
  {
    percent = Math.Int(fraction * 100);
    if (percent < 0)
      {
        percent = 0;
      }
    if (percent > 100)
      {
        percent = 100;
      }
    progress.sprite.SetImage(progress.images[percent]);
  }

Plymouth.SetBootProgressFunction(progress_callback);

fun refresh_callback ()
  {
    indicator.frame = (indicator.frame + 1) % 20;
    indicator.sprite.SetImage(indicator.images[indicator.frame]);
    footer.frame = (footer.frame + 1) % 4;
    footer.sprite.SetImage(footer.images[footer.frame]);
  }

Plymouth.SetRefreshFunction(refresh_callback);

#!/bin/sh
# jwm-layout - disposição dos monitores + wallpaper.
#
# Chamado pelo jwm-session ao iniciar e pelo próprio JWM quando um monitor é ligado/desligado.
# Funciona com qualquer combinação: só HDMI, só VGA, os dois, ou outras saídas (eDP, DP...).
#
#   HDMI à esquerda (primário, onde mora o JDesk), VGA à direita.
#   Sem HDMI, o VGA vira o primário.
#
# Ajustes sem editar o arquivo:
#   JWM_VGA_MODE=1366x768  JWM_VGA_RATE=60  JWM_VGA_ROTATE=normal|right|left|inverted
#   JWM_WALLPAPER=/caminho/imagem.jpg   (a mesma imagem em todos os monitores)
#   Wallpapers por orientação: ~/.config/jdev/horizontal.png e vertical.png (veja a seção Wallpaper)
# Tudo que acontece vai para ~/.cache/jwm-session.log
set -u

LOG=${XDG_CACHE_HOME:-$HOME/.cache}/jwm-session.log
mkdir -p "$(dirname -- "$LOG")" 2>/dev/null || true
logar() { printf '%s %s\n' "$(date '+%F %T')" "layout: $*" >> "$LOG" 2>/dev/null || true; }
tentar() {
    if "$@" 2>>"$LOG"; then
        logar "ok: $*"
    else
        st=$?
        logar "FALHOU ($st): $*"
        return "$st"
    fi
}

VGA_MODE=${JWM_VGA_MODE:-1600x900}
VGA_RATE=${JWM_VGA_RATE:-60}
VGA_ROTATE=${JWM_VGA_ROTATE:-right}   # "right" deixa o monitor em pé (900x1600)

if ! command -v xrandr >/dev/null 2>&1; then
    logar "xrandr não encontrado; nada a fazer"
    exit 0
fi

QUERY=$(xrandr --query 2>/dev/null || true)
CONECTADAS=$(printf '%s\n' "$QUERY" | awk '$2=="connected"{print $1}')
DESCONECTADAS=$(printf '%s\n' "$QUERY" | awk '$2=="disconnected"{print $1}')
logar "conectadas: $(printf '%s' "$CONECTADAS" | tr '\n' ' ')| desconectadas: $(printf '%s' "$DESCONECTADAS" | tr '\n' ' ')"

# ── Escolhe quem é o primário e a ordem (esquerda -> direita) ────────────────
PRIM=$(printf '%s\n' "$CONECTADAS" | grep -m1 '^HDMI' || true)
[ -n "$PRIM" ] || PRIM=$(printf '%s\n' "$CONECTADAS" | head -n 1)
VGA=$(printf '%s\n' "$CONECTADAS" | grep -m1 '^VGA' || true)

ORDEM=""
if [ -n "$PRIM" ]; then
    ORDEM=$PRIM
    for o in $CONECTADAS; do
        [ "$o" = "$PRIM" ] || ORDEM="$ORDEM $o"
    done
fi

# ── Modo do VGA: o do EDID se existir, senão cria com cvt ────────────────────
# Importante: nada aqui mexe nos parâmetros posicionais do script (um "set --" solto no
# jwm-session antigo trocava os argumentos que iam para o JWM e derrubava a sessão).
modo_vga_para() {
    saida=$1
    if printf '%s\n' "$QUERY" | awk -v o="$saida" '$1==o{f=1;next} /^[^ ]/{f=0} f{print $1}' \
            | grep -qx "$VGA_MODE"; then
        printf '%s\n' "$VGA_MODE"
        return 0
    fi
    linha=""
    if command -v cvt >/dev/null 2>&1; then
        w=${VGA_MODE%x*}
        h=${VGA_MODE#*x}
        linha=$(cvt "$w" "$h" "$VGA_RATE" 2>/dev/null \
                | sed -n 's/^Modeline "\([^"]*\)" *\(.*\)$/\1 \2/p')
    fi
    if [ -n "$linha" ]; then
        nome=${linha%% *}
        params=${linha#* }
        # shellcheck disable=SC2086
        xrandr --newmode "$nome" $params >/dev/null 2>&1 || true
        xrandr --addmode "$saida" "$nome" >/dev/null 2>&1 || true
        printf '%s\n' "$nome"
        return 0
    fi
    printf '\n'   # sem modo: o chamador usa --auto
}

# aplicar custom|auto  -> monta e roda um único xrandr com todas as saídas conectadas
aplicar() {
    tipo=$1
    set --
    anterior=""
    for o in $ORDEM; do
        case $o in
            VGA*)
                modo=""
                [ "$tipo" = custom ] && modo=$(modo_vga_para "$o")
                if [ -n "$modo" ]; then
                    set -- "$@" --output "$o" --mode "$modo" --rotate "$VGA_ROTATE"
                else
                    set -- "$@" --output "$o" --auto --rotate "$VGA_ROTATE"
                fi
                ;;
            *)
                set -- "$@" --output "$o" --auto --rotate normal
                ;;
        esac
        [ "$o" = "$PRIM" ] && set -- "$@" --primary
        [ -n "$anterior" ] && set -- "$@" --right-of "$anterior"
        anterior=$o
    done
    tentar xrandr "$@"
}

if [ -n "$ORDEM" ]; then
    # Saídas sem monitor são desligadas (uma por vez: se uma falhar, as outras seguem).
    for o in $DESCONECTADAS; do
        xrandr --output "$o" --off >/dev/null 2>&1 || true
    done
    if ! aplicar custom; then
        logar "modo personalizado falhou; tentando o modo automático"
        aplicar auto || logar "não consegui ajustar os monitores automaticamente"
    fi
else
    logar "nenhuma saída conectada segundo o xrandr; deixando o X como está"
fi

# ── Wallpaper ────────────────────────────────────────────────────────────────
# Um por monitor, escolhido pela orientação REAL de cada um (lida do xrandr depois que a
# rotação foi aplicada, então vale para qualquer combinação):
#   em pé    (altura > largura: rotate left/right)  -> ~/.config/jdev/vertical.{png,jpg,jpeg,webp}
#   deitado  (rotate normal/inverted)               -> ~/.config/jdev/horizontal.{png,jpg,jpeg,webp}
# Cada imagem é ajustada ao tamanho do monitor (preenche, cortando o excesso, sem distorcer).
# Faltou um dos dois arquivos? O outro (ou wallpaper.*, ou qualquer imagem da pasta) serve.
# JWM_WALLPAPER=/caminho/imagem usa a MESMA imagem em todos os monitores.
# Ferramentas, em ordem de preferência: xwallpaper (uma imagem por saída, o ideal), feh, hsetroot.
#
# Fica na raiz do X (não é janela). O JDesk cobre o monitor primário, então na prática
# o wallpaper aparece nos outros monitores.
DIR_WP=${XDG_CONFIG_HOME:-$HOME/.config}/jdev

achar_imagem() {   # achar_imagem NOME -> imprime DIR_WP/NOME.ext (png, jpg, jpeg ou webp) se existir
    for ext in png jpg jpeg webp PNG JPG JPEG WEBP; do
        if [ -f "$DIR_WP/$1.$ext" ]; then
            printf '%s\n' "$DIR_WP/$1.$ext"
            return 0
        fi
    done
    return 1
}

WP_UNICO=${JWM_WALLPAPER:-}
case "$WP_UNICO" in "~/"*) WP_UNICO=$HOME/${WP_UNICO#"~/"} ;; esac   # "~" entre aspas não expande
WP_H=$(achar_imagem horizontal || achar_imagem wallpaper || true)
WP_V=$(achar_imagem vertical || true)
if [ -z "$WP_H" ] && [ -z "$WP_V" ]; then                       # última chance: qualquer imagem da pasta
    for ext in png jpg jpeg webp PNG JPG JPEG WEBP; do
        for cand in "$DIR_WP"/*.$ext; do
            if [ -f "$cand" ]; then
                WP_H=$cand
                break 2
            fi
        done
    done
fi
[ -n "$WP_H" ] || WP_H=$WP_V
[ -n "$WP_V" ] || WP_V=$WP_H

# "SAÍDA LARGURA ALTURA X" de cada monitor ligado, da esquerda para a direita. A geometria que o
# xrandr mostra (ex.: 900x1600+1920+0) já vem com a rotação aplicada.
MONITORES=$(xrandr --query 2>/dev/null | awk '
    $2 == "connected" {
        for (i = 3; i <= NF; i++)
            if ($i ~ /^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+$/) {
                split($i, g, /[x+-]/); print $1, g[1], g[2], g[3]; break
            }
    }' | sort -n -k4)

imagem_para() {   # imagem_para LARGURA ALTURA -> vertical se estiver em pé, senão horizontal
    if [ "$2" -gt "$1" ]; then printf '%s\n' "$WP_V"; else printf '%s\n' "$WP_H"; fi
}

aplicar_wallpaper() {
    if command -v xwallpaper >/dev/null 2>&1; then
        if [ -n "$WP_UNICO" ]; then
            tentar xwallpaper --zoom "$WP_UNICO"
            return
        fi
        set --
        while read -r saida w h _x; do
            [ -n "$saida" ] || continue
            set -- "$@" --output "$saida" --zoom "$(imagem_para "$w" "$h")"
            logar "wallpaper: $saida (${w}x${h}) -> $(imagem_para "$w" "$h")"
        done <<EOF
$MONITORES
EOF
        if [ "$#" -gt 0 ]; then
            tentar xwallpaper "$@" || tentar xwallpaper --zoom "$WP_H"
        else
            tentar xwallpaper --zoom "$WP_H"
        fi
    elif command -v feh >/dev/null 2>&1; then
        # feh associa as imagens aos monitores pela ordem (esquerda -> direita); sem xwallpaper
        # é o melhor que dá. Recomendado: sudo xbps-install xwallpaper
        if [ -n "$WP_UNICO" ]; then
            tentar feh --no-fehbg --bg-fill "$WP_UNICO"
            return
        fi
        set --
        while read -r saida w h _x; do
            [ -n "$saida" ] || continue
            set -- "$@" "$(imagem_para "$w" "$h")"
        done <<EOF
$MONITORES
EOF
        if [ "$#" -gt 0 ]; then
            tentar feh --no-fehbg --bg-fill "$@"
        else
            tentar feh --no-fehbg --bg-fill "$WP_H"
        fi
    elif command -v hsetroot >/dev/null 2>&1; then
        tentar hsetroot -fill "${WP_UNICO:-$WP_H}"
    else
        logar "wallpaper: falta xwallpaper/feh/hsetroot (sudo xbps-install -S xwallpaper)"
    fi
}

if [ -z "$WP_UNICO" ] && [ -z "$WP_H" ]; then
    logar "wallpaper: nenhuma imagem (procurei em $DIR_WP: horizontal.* e vertical.*)"
elif [ -n "$WP_UNICO" ] && [ ! -f "$WP_UNICO" ]; then
    logar "wallpaper: arquivo não existe: $WP_UNICO"
else
    aplicar_wallpaper || true
fi
exit 0

#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# Dentro do startx não há terminal para ver erros: tudo que importa vai para este log.
LOG=${XDG_CACHE_HOME:-$HOME/.cache}/jwm-session.log
mkdir -p "$(dirname -- "$LOG")" 2>/dev/null || true
printf '%s %s\n' "$(date '+%F %T')" "sessão iniciada (DISPLAY=${DISPLAY:-?})" >> "$LOG" 2>/dev/null || true

# Monitores + wallpaper (HDMI/VGA, só um deles, ou os dois). Também é chamado pelo JWM
# quando um monitor é ligado/desligado. Nunca derruba a sessão: se falhar, segue sem.
if [ -f "$HERE/jwm-layout" ]; then
    sh "$HERE/jwm-layout" >/dev/null 2>&1 || \
        printf '%s %s\n' "$(date '+%F %T')" "jwm-layout falhou" >> "$LOG" 2>/dev/null || true
fi

exec python3 "$HERE/JWM.py" "$@"

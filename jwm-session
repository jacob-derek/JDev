#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# Barramento D-Bus de sessão: o JToast (e qualquer app que mande notificação) precisa dele. Sem ele
# o Xorg sobe "pelado". Se faltar, reexecuta esta mesma sessão dentro de um dbus-run-session.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -z "${JWM_DBUS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    JWM_DBUS=1 exec dbus-run-session -- sh "$HERE/jwm-session" "$@"
fi

# Dentro do startx não há terminal para ver erros: tudo que importa vai para este log.
LOG=${XDG_CACHE_HOME:-$HOME/.cache}/jwm-session.log
mkdir -p "$(dirname -- "$LOG")" 2>/dev/null || true
printf '%s %s\n' "$(date '+%F %T')" "sessão iniciada (DISPLAY=${DISPLAY:-?})" >> "$LOG" 2>/dev/null || true

# Cursor: tira o "X" do Xorg e usa o Bibata (instalado em ~/.icons)
export XCURSOR_THEME="${XCURSOR_THEME:-Bibata-Modern-Classic}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
command -v xsetroot >/dev/null 2>&1 && xsetroot -cursor_name left_ptr || true

# Monitores + wallpaper (HDMI/VGA, só um deles, ou os dois). Também é chamado pelo JWM
# quando um monitor é ligado/desligado. Nunca derruba a sessão: se falhar, segue sem.
if [ -f "$HERE/jwm-layout" ]; then
    sh "$HERE/jwm-layout" >/dev/null 2>&1 || \
        printf '%s %s\n' "$(date '+%F %T')" "jwm-layout falhou" >> "$LOG" 2>/dev/null || true
fi

# Compositor leve (sem sombras, blur ou animações de janela).
PICOM_CONF=${XDG_CONFIG_HOME:-$HOME/.config}/picom/picom.conf
if ! command -v picom >/dev/null 2>&1; then
    printf '%s %s\n' "$(date '+%F %T')" "picom não instalado; seguindo sem compositor" >> "$LOG" 2>/dev/null || true
elif [ ! -f "$PICOM_CONF" ]; then
    printf '%s %s\n' "$(date '+%F %T')" "sem $PICOM_CONF; picom não iniciado" >> "$LOG" 2>/dev/null || true
elif ! pgrep -x picom >/dev/null 2>&1; then
    picom --config "$PICOM_CONF" >> "$LOG" 2>&1 &
    PICOM_PID=$!
    sleep 0.3
    if ! kill -0 "$PICOM_PID" 2>/dev/null; then
        printf '%s %s\n' "$(date '+%F %T')" "picom (glx) falhou; tentando xrender" >> "$LOG" 2>/dev/null || true
        picom --config "$PICOM_CONF" --backend xrender >> "$LOG" 2>&1 &
    fi
fi

# Notificações (JToast): opcional. Sem o jeepney ou sem barramento, só registra no log e segue.
if [ -f "$HERE/JToast.py" ] && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && python3 -c 'import jeepney' >/dev/null 2>&1; then
    python3 "$HERE/JToast.py" >> "$LOG" 2>&1 &
else
    printf '%s %s\n' "$(date '+%F %T')" "JToast não iniciado (sem D-Bus de sessão ou sem jeepney)" >> "$LOG" 2>/dev/null || true
fi

# Doodles de borboleta, vagalumes e fantasma!
if [ "${JDOODLES:-1}" != "0" ] && [ -f "$HERE/jdoodles.py" ] && python3 -c 'import Xlib' 2>/dev/null; then
    python3 "$HERE/jdoodles.py" >> "$LOG" 2>&1 &
fi

# Abertura: os passarinhos aguardam o sinal do JDesk quando houver interface.
# No modo --no-ui, a cortina revela o wallpaper após a mesma espera máxima.
if [ "${JBIRDS:-1}" != "0" ] && [ -f "$HERE/jbirds.py" ]; then
    PRONTO="${XDG_CACHE_HOME:-$HOME/.cache}/jdev/pronto"
    mkdir -p "$(dirname "$PRONTO")" && rm -f "$PRONTO"
    case " $* " in *" --no-ui "*) python3 "$HERE/jbirds.py" --sem-ui >> "$LOG" 2>&1 & ;;
        *) python3 "$HERE/jbirds.py" >> "$LOG" 2>&1 & ;;
    esac
fi
# Boas-vindas + avisos de "app aberto" (JHELLO=0 desliga)
case " $* " in *" --no-ui "*) ;; *)
    # Boas-vindas + avisos de "app aberto" (JHELLO=0 desliga)
    if [ "${JHELLO:-1}" != "0" ] && [ -f "$HERE/jhello.py" ] && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        python3 "$HERE/jhello.py" >> "$LOG" 2>&1 &
    fi ;;
esac

exec python3 "$HERE/JWM.py" "$@"
